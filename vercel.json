{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "destination": "main.py"
    },
    {
      "src": "/health",
      "destination": "main.py"
    },
    {
      "src": "/webhook",
      "destination": "main.py"
    },
    {
      "src": "/(.*)",
      "destination": "/static/index.html"
    }
  ]
}
